# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000

# Security - CRITICAL: Generate new JWT secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_hex_secret_here

# Admin Credentials - CHANGE THESE IMMEDIATELY
ADMIN_EMAIL=admin@morphedtech.com
ADMIN_PASSWORD=your_secure_password_here

# CORS Configuration
# For production, set to your actual domain: https://yourdomain.com
FRONTEND_URL=http://localhost:5000

# Payment Configuration
UPI_ID=7038376253@ybl
UPI_NAME=Morphed Tech
COURSE_PRICE=7777

# Optional: Email Configuration (for future features)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Optional: AWS Configuration (for future features)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket-name
