# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000

# Security - CRITICAL: Generate new JWT secret for production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_hex_secret_here

# Admin Credentials - CHANGE THESE IMMEDIATELY
ADMIN_EMAIL=admin@morphedtech.com
ADMIN_PASSWORD=your_secure_password_here

# CORS Configuration
# For production, set to your actual domain: https://yourdomain.com
FRONTEND_URL=http://localhost:5000

# Payment Configuration
UPI_ID=7038376253@ybl
UPI_NAME=Mrs HIRA ANGAD KAMBALE
COURSE_PRICE=7777
LIMITED_SEATS=54

# Admin alerts — Telegram (free, ~5 min setup via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Admin alerts — WhatsApp Cloud API (Meta Business)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ADMIN_PHONE=917038376253
# Optional: WHATSAPP_API_VERSION=v21.0

# Google Gemini AI (free tier) — AI Mock Interview
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
MOCK_INTERVIEW_DAILY_LIMIT=3
MOCK_INTERVIEW_FREE_TRIAL=2

# RAG Study Bot (uses same GEMINI_API_KEY)
STUDY_BOT_RATE_LIMIT=15
STUDY_BOT_FREE_TRIAL=7

# Set to false when Gemini quota is ready and AI features should go live
AI_FEATURES_COMING_SOON=true

# Optional: OpenAI (not required if using Gemini)
# OPENAI_API_KEY=
# EMAIL_HOST=smtp.gmail.com

# Optional: MongoDB (for production — if not set, uses SQLite locally)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/morphedtech?retryWrites=true&w=majority
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Optional: AWS Configuration (for future features)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket-name
